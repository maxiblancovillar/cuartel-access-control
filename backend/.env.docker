# Este archivo documenta las variables usadas en el contenedor backend.
# En docker-compose.yml estas variables se inyectan directamente via `environment:`,
# por lo que este archivo es solo referencia (no se copia a la imagen, ver .dockerignore).

# Database (host = nombre del servicio postgres en la red de docker-compose)
DATABASE_URL="postgresql://cuartel_user:MiPassword123@postgres:5432/cuartel_db"

# JWT
JWT_SECRET="super-secret-key-min-32-characters-must-be"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="production"

# Logs
LOG_LEVEL="info"
